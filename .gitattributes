# Normalisation des fins de ligne : LF dans le depot, CRLF au checkout Windows.
* text=auto eol=lf

# Fichiers binaires (ne jamais toucher)
*.mp4    binary
*.mp3    binary
*.ogg    binary
*.wav    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary

# CSS et JS : forcer LF
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
